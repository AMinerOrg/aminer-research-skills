# Fill exactly one model profile. Never commit real credentials.

# Required for the default AMiner search provider, --pub-id Interface B input,
# automatic title-to-pub_id resolution, or backward-reference expansion.
AMINER_API_KEY=
# AMINER_SKILL_RUNTIME=codex

# Optional outbound proxy for AMiner or explicitly selected arXiv/OpenAlex. Configure only when
# direct egress is unavailable; do not commit proxy credentials.
HTTPS_PROXY=
HTTP_PROXY=

# Default: GLM 5.3 with low reasoning. GLM 5.2 and Flash are explicit alternatives.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
GLM53_MODEL=glm-5.3
GLM53_FLASH_MODEL=glm-5.3-flash
GLM53_THINKING_EFFORT=low

# Optional DeepSeek profile (base URL defaults to the official endpoint).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GPT requires an explicitly trusted OpenAI-compatible endpoint.
GPT_API_KEY=
GPT_BASE_URL=
GPT_MODEL=gpt-5.6-sol

# Optional local service and runtime settings.
GROBID_URL=http://127.0.0.1:8070
# RELATED_WORK_AUDIT_WORK_DIR=/absolute/private/path
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MAX_RETRIES=0
